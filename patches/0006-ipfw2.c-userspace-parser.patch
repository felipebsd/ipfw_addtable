Add userspace parsing and display of the addtable action (sbin/ipfw/ipfw2.c).

Syntax:
    ipfw add <num> addtable <tblno> [src|dst] <body>

  tblno   : table number 0-65535
  src|dst : whether to add source (default) or destination IP

Examples:
    ipfw add 100 addtable 5 src from any to any
    ipfw add 200 addtable 6 dst from any to 192.168.0.0/24

Display example:
    00100 addtable 5 src from any to any

--- a/sbin/ipfw/ipfw2.c
+++ b/sbin/ipfw/ipfw2.c
@@ rule_actions[] @@
 	{ "setmark",	TOK_SETMARK },
+	{ "addtable",	TOK_ADDTABLE },
 	{ NULL, 0 }	/* terminator */
 };

--- a/sbin/ipfw/ipfw2.c
+++ b/sbin/ipfw/ipfw2.c
@@ TOK_SETMARK parsing case in the add_rule() action switch @@
+	case TOK_ADDTABLE: {
+		ipfw_insn_addtable *at;
+		long tbl;
+		char *end;
+
+		NEED1("addtable needs a table number");
+		errno = 0;
+		tbl = strtol(*av, &end, 10);
+		if (errno == ERANGE || *end != '\0' || tbl < 0 || tbl > 65535)
+			errx(EX_USAGE,
+			    "addtable: table number must be 0-65535");
+		av++; ac--;
+
+		at = (ipfw_insn_addtable *)cmd;
+		memset(at, 0, sizeof(*at));
+		at->o.opcode = O_ADDTABLE;
+		at->o.len    = F_INSN_SIZE(ipfw_insn_addtable);
+		at->o.arg1   = (uint16_t)tbl;
+		/* at->flags = 0: source address (default); _pad[3] zeroed above */
+
+		/* optional src|dst keyword */
+		if (ac > 0 && strcasecmp(*av, "dst") == 0) {
+			at->flags = ADDTABLE_F_DST;
+			av++; ac--;
+		} else if (ac > 0 && strcasecmp(*av, "src") == 0) {
+			av++; ac--;	/* consume explicit "src" */
+		}
+
+		cmd = next_cmd(cmd, &l);
+		break;
+	}

--- a/sbin/ipfw/ipfw2.c
+++ b/sbin/ipfw/ipfw2.c
@@ O_SETMARK case in print_action_instruction() @@
+	case O_ADDTABLE: {
+		ipfw_insn_addtable *at = (ipfw_insn_addtable *)cmd;
+
+		bprintf(bp, " addtable %u %s",
+		    (unsigned)at->o.arg1,
+		    (at->flags & ADDTABLE_F_DST) ? "dst" : "src");
+		break;
+	}
